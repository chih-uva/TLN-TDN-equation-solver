Cell[CellGroupData[{

Cell["Defining the TOV equations", "Subsection",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.978006057826025*^9, 3.9780060745417747`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"3d9af7c0-ea9c-43d0-8f64-5143e42d4854"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TOV", " ", "=", " ", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"p", "[", "r", "]"}], ",", "r"}], "]"}], " ", "==", " ", 
     FractionBox[
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"p", "[", "r", "]"}], "+", 
          RowBox[{"\[Rho]", "[", "r", "]"}]}], ")"}]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"m", "[", "r", "]"}], " ", "+", " ", 
         RowBox[{"4", "*", "Pi", "*", 
          SuperscriptBox["r", "3"], "*", 
          RowBox[{"p", "[", "r", "]"}]}]}], ")"}]}], 
      RowBox[{"r", 
       RowBox[{"(", 
        RowBox[{"r", " ", "-", " ", 
         RowBox[{"2", 
          RowBox[{"m", "[", "r", "]"}]}]}], ")"}]}]]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"1", " ", "polytrope"}]}], ",", " ", 
    RowBox[{"\[Rho]", " ", "is", " ", "energy", " ", "density"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EOS", "[", "p_", "]"}], " ", ":=", " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"4", "*", "K", "*", "p"}], ")"}], 
         RowBox[{"1", "/", "2"}]]}], ")"}], "2"], "-", "1"}], 
    RowBox[{"4", "*", "K"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lamEQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"m", "[", "r", "]"}], "==", " ", 
    RowBox[{
     FractionBox["1", "2"], "*", "r", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Exp", "[", 
        RowBox[{"\[Lambda]", "[", "r", "]"}], "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"massEQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"m", "[", "r", "]"}], ",", "r"}], "]"}], "==", 
    RowBox[{"4", "*", "Pi", "*", 
     SuperscriptBox["r", "2"], "*", 
     RowBox[{"\[Rho]", "[", "r", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nuEQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[Nu]", "[", "r", "]"}], ",", "r"}], "]"}], " ", "==", " ", 
    FractionBox[
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"m", "[", "r", "]"}], " ", "+", " ", 
        RowBox[{"4", "*", "Pi", "*", 
         SuperscriptBox["r", "3"], "*", 
         RowBox[{"p", "[", "r", "]"}]}]}], ")"}]}], 
     RowBox[{"r", 
      RowBox[{"(", 
       RowBox[{"r", " ", "-", " ", 
        RowBox[{"2", 
         RowBox[{"m", "[", "r", "]"}]}]}], ")"}]}]]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9780060804430647`*^9, 3.978006081780497*^9}, {
  3.9780061378425217`*^9, 3.9780061456306143`*^9}, {3.9780066417944317`*^9, 
  3.978006700175111*^9}, {3.9780068053616667`*^9, 3.9780068945490103`*^9}, {
  3.978006997677203*^9, 3.978006998582222*^9}, {3.978007223500649*^9, 
  3.97800723070982*^9}, {3.978007385341866*^9, 3.978007442109748*^9}, {
  3.97800749875942*^9, 3.978007550349287*^9}, {3.978007592974186*^9, 
  3.978007610402203*^9}, {3.9780076438009777`*^9, 3.978007705657501*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"8c5af55a-b471-42c3-8314-d514a0e7ffda"]
}, Open  ]],

