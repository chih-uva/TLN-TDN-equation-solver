Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Taking", " ", "log", " ", "of", " ", "the", " ", "lambda", " ", 
    "equation"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lambdaFromm", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", 
         RowBox[{"2", "*", 
          RowBox[{"mSeries", "/", "r"}]}]}], "]"}]}], "//", "Simplify"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"lambdaSeries", "=", 
     RowBox[{
      RowBox[{"Normal", "@", 
       RowBox[{"Series", "[", 
        RowBox[{"lambdaFromm", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "0", ",", "8"}], "}"}]}], "]"}]}], "//", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Creating", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lambdaMatchEq", "=", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"CoefficientList", "[", 
        RowBox[{
         RowBox[{"\[Lambda]Sub", "-", "lambdaSeries"}], ",", "r"}], "]"}], "==",
        "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"lambdaSol", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{"lambdaMatchEq", ",", 
         RowBox[{"{", 
          RowBox[{
          "\[Lambda]c", ",", "\[Lambda]2", ",", "\[Lambda]4", ",", 
           "\[Lambda]6", ",", "\[Lambda]8"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "//", "Simplify"}]}], 
    ";"}]}]}]], "Input",
