  0.85],ExpressionUUID->"ae9db3e9-4e14-42d0-b2ba-43e0387c686d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pSub", " ", "=", 
   RowBox[{"pc", " ", "+", " ", 
    RowBox[{"p2", "*", 
     SuperscriptBox["r", "2"]}], "+", " ", 
    RowBox[{"p4", "*", 
     SuperscriptBox["r", "4"]}], " ", "+", " ", 
    RowBox[{"p6", "*", 
     SuperscriptBox["r", "6"]}], "+", 
    RowBox[{"p8", "*", 
     SuperscriptBox["r", "8"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mSub", " ", "=", " ", 
   RowBox[{"4", "*", "Pi", "*", 
    SuperscriptBox["r", "3"], 
    RowBox[{"(", 
     RowBox[{"mc", " ", "+", " ", 
      RowBox[{"m2", "*", 
       SuperscriptBox["r", "2"]}], "+", " ", 
      RowBox[{"m4", "*", 
       SuperscriptBox["r", "4"]}], " ", "+", " ", 
      RowBox[{"m6", "*", 
       SuperscriptBox["r", "6"]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]EOS", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"EOS", "[", "pSub", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "8"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]Sub", "=", " ", 
   RowBox[{"\[Rho]c", " ", "+", " ", 
    RowBox[{"\[Rho]2", "*", 
     SuperscriptBox["r", "2"]}], "+", " ", 
    RowBox[{"\[Rho]4", "*", 
     SuperscriptBox["r", "4"]}], " ", "+", " ", 
    RowBox[{"\[Rho]6", "*", 
     SuperscriptBox["r", "6"]}], "+", 
    RowBox[{"\[Rho]8", "*", 
     SuperscriptBox["r", "8"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Nu]Sub", "=", " ", 
   RowBox[{"\[Nu]c", " ", "+", " ", 
    RowBox[{"\[Nu]2", "*", 
     SuperscriptBox["r", "2"]}], "+", " ", 
    RowBox[{"\[Nu]4", "*", 
     SuperscriptBox["r", "4"]}], " ", "+", " ", 
    RowBox[{"\[Nu]6", "*", 
     SuperscriptBox["r", "6"]}], "+", 
    RowBox[{"\[Nu]8", "*", 
     SuperscriptBox["r", "8"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]Sub", "=", " ", 
   RowBox[{"\[Lambda]c", " ", "+", " ", 
    RowBox[{"\[Lambda]2", "*", 
     SuperscriptBox["r", "2"]}], "+", " ", 
    RowBox[{"\[Lambda]4", "*", 
     SuperscriptBox["r", "4"]}], " ", "+", " ", 
    RowBox[{"\[Lambda]6", "*", 
     SuperscriptBox["r", "6"]}], "+", 
    RowBox[{"\[Lambda]8", "*", 
     SuperscriptBox["r", "8"]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.978006729228438*^9, 3.9780067818859863`*^9}, {
  3.978006942311928*^9, 3.97800699039296*^9}, {3.978007022649135*^9, 
