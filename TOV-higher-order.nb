Cell[TextData[{
 "Defining polynomial ansatz for the background variables up to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "8"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "187f9c46-266a-409e-ba63-b3613689ed93"]
