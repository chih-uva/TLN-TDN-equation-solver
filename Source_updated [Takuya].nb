      RowBox[{"D", "[", 
       RowBox[{"EqBG", ",", "r"}], "]"}]}], "/.", "EqBG"}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]pH00", "=", 
