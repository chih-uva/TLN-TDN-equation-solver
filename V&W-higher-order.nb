Cell[BoxData[
 RowBox[{
  RowBox[{"KSub", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"K\[Epsilon]\[Omega]0", "[", "r", "]"}], "\[Rule]", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "L", "+", 
        SuperscriptBox["L", "2"]}]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        RowBox[{"\[Lambda]", "[", "r", "]"}]}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"H\[Epsilon]\[Omega]0", "[", "r", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"\[Lambda]", "[", "r", "]"}]]}], "+", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"2", " ", 
             RowBox[{"\[Lambda]", "[", "r", "]"}]}]], "+", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"\[Lambda]", "[", "r", "]"}]], " ", "L"}], "+", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"\[Lambda]", "[", "r", "]"}]], " ", 
            SuperscriptBox["L", "2"]}], "+", 
           RowBox[{"8", " ", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"\[Lambda]", "[", "r", "]"}]], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "3"}], "+", 
              RowBox[{"2", " ", 
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{"\[Lambda]", "[", "r", "]"}]]}]}], ")"}], " ", 
            "\[Pi]", " ", 
            SuperscriptBox["r", "2"], " ", 
            RowBox[{"p0", "[", "r", "]"}]}], "+", 
           RowBox[{"64", " ", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"2", " ", 
              RowBox[{"\[Lambda]", "[", "r", "]"}]}]], " ", 
            SuperscriptBox["\[Pi]", "2"], " ", 
            SuperscriptBox["r", "4"], " ", 
            SuperscriptBox[
             RowBox[{"p0", "[", "r", "]"}], "2"]}], "-", 
           RowBox[{"8", " ", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"\[Lambda]", "[", "r", "]"}]], " ", "\[Pi]", " ", 
            SuperscriptBox["r", "2"], " ", 
            RowBox[{"\[Rho]0", "[", "r", "]"}]}]}], ")"}]}], "+", 
        RowBox[{"r", " ", 
