Cell[TextData[{
 "The",
 StyleBox[" Zeroth order ",
  FontWeight->"Bold"],
 "equation for W and V are the same, we let v0 be the free parameter, and the \
solution is expressed in terms of ",
 StyleBox["pc, a0, v0.",
  FontWeight->"Bold"],
 " Theses are then determined by matching the interior and exterior solutions \
at the stellar surface."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9813950610671263`*^9, 3.9813951086940393`*^9}, {
  3.981395178241403*^9, 3.981395255744248*^9}},
