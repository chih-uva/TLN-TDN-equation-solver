Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"m", ",", " ", "p0", ",", " ", "\[Rho]0", ",", " ", 
    RowBox[{
    "\[Nu]", " ", "are", " ", "solved", " ", "from", " ", "the", " ", "TOV", 
     " ", "equation", "\[IndentingNewLine]", "\[Xi]0", " ", "is", " ", "the", 
     " ", "zeroth", " ", "order", " ", "of", " ", "\[Rho]0"}], ",", " ", 
    RowBox[{
    "P0", " ", "is", " ", "the", " ", "zeroth", " ", "order", " ", "of", " ", 
     "p0"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"m", "[", "r_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"4", "\[Pi]"}], "3"], "\[Xi]0", "*", 
       SuperscriptBox["r", "3"]}], "+", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"4", "\[Pi]"}], "5"], "\[Rho]2", "*", 
       SuperscriptBox["r", "5"]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"p0", "[", "r_", "]"}], ":=", 
     RowBox[{"P0", "-", 
      RowBox[{
       FractionBox[
        RowBox[{"2", " ", "\[Pi]"}], "3"], 
       RowBox[{"(", 
        RowBox[{"P0", "+", "\[Xi]0"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", "P0"}], "+", "\[Xi]0"}], ")"}], 
       SuperscriptBox["r", "2"]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"n", "=", 
     RowBox[{
     "1", " ", "is", " ", "used", " ", "in", " ", "the", " ", "polytropic", 
      " ", "EOS"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]0", "[", "r_", "]"}], ":=", 
     RowBox[{"\[Xi]0", "+", 
      RowBox[{"\[Rho]2", "*", 
       SuperscriptBox["r", "2"]}]}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Nu]", "[", "r_", "]"}], ":=", 
     RowBox[{"\[Nu]0", "+", 
      RowBox[{
       FractionBox[
        RowBox[{"4", "\[Pi]"}], "3"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", "P0"}], "+", "\[Xi]0"}], ")"}], 
       SuperscriptBox["r", "2"]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cs2", "[", "r_", "]"}], ":=", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        FractionBox["\[Gamma]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"p0", "[", "r", "]"}], "/", 
             RowBox[{"\[Rho]0", "[", "r", "]"}]}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Rho]0", "[", "r", "]"}], "/", 
            RowBox[{"p0", "[", "r", "]"}]}], ")"}]}]], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]", "[", "r_", "]"}], ":=", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
           RowBox[{"2", "*", 
            RowBox[{
             RowBox[{"m", "[", "r", "]"}], "/", "r"}]}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
