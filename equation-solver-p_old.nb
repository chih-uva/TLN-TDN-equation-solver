        RowBox[{"\[Rho]0", "[", "r", "]"}], "+", 
        RowBox[{"p0", "[", "r", "]"}]}], ")"}], 
      RowBox[{"Exp", "[", 
       RowBox[{"\[Lambda]", "[", "r", "]"}], "]"}], 
      RowBox[{"V", "[", "r", "]"}]}], "-", 
     RowBox[{"32", " ", "\[Pi]", " ", "I", " ", "\[Omega]", "  ", 
      RowBox[{"\[Eta]", "[", "r", "]"}], 
      FractionBox[
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"\[Lambda]", "[", "r", "]"}], "-", 
         RowBox[{
          RowBox[{"\[Nu]", "[", "r", "]"}], "/", "2"}]}], "]"}], "r"], 
