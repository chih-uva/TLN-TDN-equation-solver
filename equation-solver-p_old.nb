Cell[BoxData[
 RowBox[{
  RowBox[{"eqn26", " ", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"H1", "[", "r", "]"}], ",", "r"}], "]"}], "==", 
