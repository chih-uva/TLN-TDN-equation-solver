Cell[TextData[StyleBox["The equation for K in the static limit, which will be \
used for the source term for H1\[Epsilon]",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.978715472031845*^9, 3.9787155326793013`*^9}, {
  3.9787198244937487`*^9, 3.978719848265463*^9}, {3.978722847733119*^9, 
  3.978722849024976*^9}},ExpressionUUID->"bd1c59d0-92c0-43ae-a9d9-\
d19bb366889a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EqforK\[Epsilon]\[Omega]0", "=", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"EqforK", "/.", "Rules"}], "/.", "EqBG"}], "/.", 
           RowBox[{
            RowBox[{"S1", "[", "r", "]"}], "->", "0"}]}], "/.", 
          RowBox[{
           RowBox[{"SZ", "[", "r", "]"}], "->", "0"}]}], "/.", 
         RowBox[{
          RowBox[{
           SuperscriptBox["S1", "\[Prime]",
            MultilineFunction->None], "[", "r", "]"}], "->", "0"}]}], "/.", 
        RowBox[{
         RowBox[{"S\[CapitalOmega]", "[", "r", "]"}], "->", "0"}]}], "/.", 
       RowBox[{
        RowBox[{"S0", "[", "r", "]"}], "->", "0"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Omega]", ",", "0", ",", "0"}], "}"}]}], "]"}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Coefficient", "[", 
    RowBox[{"EqforK\[Epsilon]\[Omega]0", ",", "\[Epsilon]", ",", "1"}], "]"}],
    "//", "Simplify"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"solK\[Epsilon]\[Omega]0", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"EqforK\[Epsilon]\[Omega]0", "==", "0"}], ",", 
      RowBox[{"K\[Epsilon]\[Omega]0", "[", "r", "]"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}], "//", "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.97869664680936*^9, 3.978696649658147*^9}, {
   3.978696680894231*^9, 3.978696786271319*^9}, {3.97869684022714*^9, 
