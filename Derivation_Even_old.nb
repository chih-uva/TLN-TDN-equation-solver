Cell[TextData[StyleBox["\[Gamma] should coincide with the perfect-fluid case \
in the current viscous model, as no time component in the non-equilibrium \
correction implies no entropy variations",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.978715472031845*^9, 3.978715497633102*^9}, {
