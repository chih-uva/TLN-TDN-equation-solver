          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[Lambda]", "[", "r", "]"}]], " ", "r", " ", 
           RowBox[{"m", "[", "r", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             RowBox[{"16", " ", "\[Pi]", " ", 
              SuperscriptBox["r", "2"], " ", 
              RowBox[{"p0", "[", "r", "]"}]}]}], ")"}]}]}], ")"}]}], "+", 
       RowBox[{"8", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"\[Nu]", "[", "r", "]"}], "2"]}]], " ", "\[Pi]", " ", 
        SuperscriptBox["r", "4"], " ", 
        RowBox[{"Xn", "[", "r", "]"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"r", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "r"}], "+", 
