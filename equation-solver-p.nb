Cell[CellGroupData[{

Cell["Solve the equations", "Section",
 CellChangeTimes->{{3.965850778288116*^9, 
  3.965850783408662*^9}},ExpressionUUID->"e35bfcc0-edd9-4c92-a832-\
5add7331e06c"],

Cell["\<\
We have 12 variables to solve for (0,1,2)th order coefficients for the 4 \
polynomials, we are omitting the third order for now, but it is an option to \
investigate higher order later. If we also have 12 linearly independent \
equations. Ideally, we should be able to express all the variables (hh0, k0, \
w0, xn0, hh1, k1, w1, xn1, hh2, k2, w2, xn2 ) with known values, such as (P0, \
\[Xi]0, \[Rho]2, \[Nu]0) and numerical values. We will check if the equations \
are linearly independent below.\
\>", "Text",
 CellChangeTimes->{{3.9658507993513117`*^9, 3.965850975277781*^9}, {
  3.965851743997188*^9, 3.9658517486467867`*^9}, {3.965852286758687*^9, 
  3.9658523073995447`*^9}},ExpressionUUID->"a0da1bd5-5d83-423d-9e51-\
6bf818b7b49f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"EQNs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"hh0", " ", "==", 
      RowBox[{"HH0Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
     RowBox[{"hh1", " ", "==", 
      RowBox[{"HH1Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
     RowBox[{"hh2", " ", "==", 
      RowBox[{"HH2Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"k0", " ", "==", 
      RowBox[{"K0Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"k1", " ", "==", 
      RowBox[{"K1Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"k1", " ", "==", 
      RowBox[{"K2Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"w0", " ", "==", " ", 
      RowBox[{"W0Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"w1", " ", "==", " ", 
      RowBox[{"W1Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"w2", " ", "==", " ", 
      RowBox[{"W2Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"xn0", " ", "==", " ", 
      RowBox[{"XN0Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"xn1", " ", "==", " ", 
      RowBox[{"XN1Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"xn2", " ", "==", " ", 
      RowBox[{"XN2Rule", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        SuperscriptBox["\[ExponentialE]", "\[Nu]0"], " ", "k0", " ", 
        RowBox[{"(", 
         RowBox[{"P0", "+", "\[Xi]0"}], ")"}]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[Nu]0", "/", "2"}]], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "xn0"}], "-", 
          RowBox[{
           FractionBox["8", "3"], " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[Nu]0", "/", "2"}]], " ", "\[Pi]", " ", "w0", " ", 
           RowBox[{"(", 
            RowBox[{"P0", "+", "\[Xi]0"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"3", " ", "P0"}], "+", "\[Xi]0"}], ")"}]}]}], ")"}]}]}], 
      "==", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VARs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "hh0", ",", "hh1", ",", "hh2", ",", "k0", ",", " ", "k1", ",", "k2", ",", 
