Cell["\<\
Here we observe that the rank of the coefficient matrix is 10, less than the \
number of variables, 12. We therefore pick out 2 variables, and allow the \
solution of the rest 10 variables contain them. We pick the two variables to \
be w0 and k0, and we will specify their values at the beginning of numerical \
integration.\
\>", "Text",
 CellChangeTimes->{{3.96585226369774*^9, 3.9658522771005383`*^9}, {
  3.965852319739374*^9, 
  3.965852416436819*^9}},ExpressionUUID->"9bdd86c7-689b-4288-ae5c-\
56e3b7f17275"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sol", "=", 
   RowBox[{
    RowBox[{"LinearSolve", "[", 
     RowBox[{"A", ",", 
      RowBox[{"-", 
       RowBox[{"Normal", "[", "b", "]"}]}]}], "]"}], "//", "FullSimplify"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.9658517991450233`*^9, 3.965851838602057*^9}, {
  3.9658519480348597`*^9, 3.9658519503822603`*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"7839e808-9136-4f35-a432-20d7a944b134"],

