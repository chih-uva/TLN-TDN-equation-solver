Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"m", ",", " ", "p0", ",", " ", "\[Rho]0", ",", " ", 
    RowBox[{
    "\[Nu]", " ", "are", " ", "solved", " ", "from", " ", "the", " ", "TOV", 
     " ", "equation", "\[IndentingNewLine]", "\[Xi]0", " ", "is", " ", "the", 
     " ", "zeroth", " ", "order", " ", "of", " ", "\[Rho]0"}], ",", " ", 
    RowBox[{
    "P0", " ", "is", " ", "the", " ", "zeroth", " ", "order", " ", "of", " ", 
     "p0"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mr0", "=", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"4", "\[Pi]"}], "3"], "\[Xi]0", "*", 
       SuperscriptBox["r", "3"]}], "+", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"4", "\[Pi]"}], "5"], "\[Rho]2", "*", 
       SuperscriptBox["r", "5"]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p0r0", "=", 
     RowBox[{"P0", "-", 
      RowBox[{
       FractionBox[
        RowBox[{"2", " ", "\[Pi]"}], "3"], 
       RowBox[{"(", 
        RowBox[{"P0", "+", "\[Xi]0"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", "P0"}], "+", "\[Xi]0"}], ")"}], 
       SuperscriptBox["r", "2"]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"n", "=", 
     RowBox[{
     "1", " ", "is", " ", "used", " ", "in", " ", "the", " ", "polytropic", 
      " ", "EOS"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]0r0", "=", 
     RowBox[{"\[Xi]0", "+", 
      RowBox[{"\[Rho]2", "*", 
       SuperscriptBox["r", "2"]}]}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Nu]r0", "=", 
     RowBox[{"\[Nu]0", "+", 
      RowBox[{
       FractionBox[
        RowBox[{"4", "\[Pi]"}], "3"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", "P0"}], "+", "\[Xi]0"}], ")"}], 
       SuperscriptBox["r", "2"]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cs2r0", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        FractionBox["\[Gamma]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"p0r0", "/", "\[Rho]0r0"}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"\[Rho]0r0", "/", "p0r0"}], ")"}]}]], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"cs2r0", "=", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         FractionBox["\[Gamma]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"p0", "[", "r", "]"}], "/", 
              RowBox[{"\[Rho]0", "[", "r", "]"}]}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Rho]0", "[", "r", "]"}], "/", 
             RowBox[{"p0", "[", "r", "]"}]}], ")"}]}]], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "0", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]r0", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
           RowBox[{"2", "*", 
            RowBox[{"mr0", "/", "r"}]}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.965286538966998*^9, 3.965286570245524*^9}, {
