        RowBox[{"H1", "[", "r", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], " ", "r", " ", 
           RowBox[{"m", "[", "r", "]"}]}], "+", 
          RowBox[{
           SuperscriptBox["r", "4"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"\[Lambda]", "[", "r", "]"}]}], "-", 
                RowBox[{"\[Nu]", "[", "r", "]"}]}]], " ", 
              SuperscriptBox["\[Omega]", "2"]}], "-", 
             RowBox[{"12", " ", "\[Pi]", " ", 
              RowBox[{"p0", "[", "r", "]"}]}]}], ")"}]}]}], ")"}]}], "+", 
       RowBox[{
        RowBox[{"K", "[", "r", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           SuperscriptBox["r", "2"]}], "-", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", 
             RowBox[{"\[Nu]", "[", "r", "]"}]}]], " ", 
           SuperscriptBox["r", "4"], " ", 
           SuperscriptBox["\[Omega]", "2"]}], "-", 
          RowBox[{"3", " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[Lambda]", "[", "r", "]"}]], " ", 
           SuperscriptBox[
            RowBox[{"m", "[", "r", "]"}], "2"]}], "+", 
          RowBox[{"4", " ", 
