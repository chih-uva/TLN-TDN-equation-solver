     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "'"}], "[", "r", "]"}], "->", "0"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Zeta]", "'"}], "[", "r", "]"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "''"}], "[", "r", "]"}], "->", "0"}], ",", 
     RowBox[{
