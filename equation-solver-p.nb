            RowBox[{"\[Lambda]", "[", "r", "]"}]], " ", "\[Pi]", " ", 
           SuperscriptBox["r", "4"], " ", 
           RowBox[{"p0", "[", "r", "]"}]}], "-", 
          RowBox[{"16", " ", 
           SuperscriptBox["\[ExponentialE]", 
