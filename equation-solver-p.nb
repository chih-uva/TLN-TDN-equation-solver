Cell["\<\
Convert to proper matrix Form of Ax == B (I think with the construction \
above, the equation is already in the desired form)\
\>", "Subsection",
 CellChangeTimes->{{3.965851368617338*^9, 
  3.965851414674594*^9}},ExpressionUUID->"02c5aefb-6ee5-4309-a737-\
0a422ed3ce00"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"EQNs0", "=", 
   RowBox[{"EQNs", "/.", " ", 
    RowBox[{"Equal", "->", "Subtract"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b", ",", "A"}], "}"}], "=", 
